# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- AWS ---
# Standard AWS credentials are picked up from `aws configure` / the default
# credential chain. These are only needed if you want to override the profile
# or region used by this project.
AWS_REGION=ap-south-1
# AWS_PROFILE=default

# --- Amazon Bedrock ---
# Model used for the agent loop. Must be enabled for your account in the
# chosen AWS_REGION.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Tavily (web search) ---
# Get a free API key (1000 searches/month) at https://tavily.com
TAVILY_API_KEY=

# --- DynamoDB ---
# Table names used for wishlist and session storage. setup.py will create
# these if they do not already exist.
DYNAMODB_WISHLIST_TABLE=mercato-wishlist
DYNAMODB_SESSIONS_TABLE=mercato-sessions

# --- S3 ---
# Bucket for session logs and comparison artifacts. Must be globally unique.
# setup.py will create this with public access fully blocked.
S3_BUCKET_NAME=your-unique-bucket-name

# --- Universal Commerce Protocol (UCP) ---
# Base endpoint for querying UCP-compliant merchants, if different from the
# public default.
# UCP_ENDPOINT=
